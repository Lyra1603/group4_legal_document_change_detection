# Set these variables in the backend process environment; no auto dotenv load.
POCS_LIGHTRAG_URL=http://127.0.0.1:9621
POCS_LIGHTRAG_WORKSPACE=pocs_comparison_a
POCS_LIGHTRAG_API_KEY=replace-with-same-local-server-key
POCS_LIGHTRAG_TIMEOUT=10
POCS_LIGHTRAG_POLL_INTERVAL=0.5
POCS_LIGHTRAG_TOP_K=8
POCS_LIGHTRAG_MAX_TOKENS=4000
POCS_LIGHTRAG_MAX_CHUNKS=100
POCS_LIGHTRAG_MAX_CHUNK_CHARS=12000
POCS_LIGHTRAG_MAX_RESPONSE_BYTES=2000000
POCS_LIGHTRAG_MODE=mix
# Explicit consent for ingestion + targeted deletion in a disposable server.
# POCS_LIGHTRAG_REAL_TEST=1
# Optional SECOND dedicated server for concurrency scenario.
# POCS_LIGHTRAG_URL_2=http://127.0.0.1:9622
# POCS_LIGHTRAG_WORKSPACE_2=pocs_comparison_b
# POCS_LIGHTRAG_API_KEY_2=replace-with-second-server-key
