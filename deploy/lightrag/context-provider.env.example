# Groq Free + Jina trial profile for the shared LightRAG demo.
LEGAL_AI_PROVIDER=groq-jina
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4
JINA_EMBEDDING_DIM=2048

# To use Gemini instead, set LEGAL_AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=replace-with-your-generation-model
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=3072
# For OpenAI, set LEGAL_AI_PROVIDER=openai and the following instead.
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-your-generation-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
