# Used only by backend.context_cli --provider-env-file; never put real keys here.
# These are examples, not a team model decision. Choose models available to your account.
LEGAL_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=replace-with-your-generation-model
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=3072
# For OpenAI, set LEGAL_AI_PROVIDER=openai and the following instead.
OPENAI_API_KEY=
OPENAI_MODEL=replace-with-your-generation-model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
