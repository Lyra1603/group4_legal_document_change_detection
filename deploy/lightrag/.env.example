# Copy to .env (ignored). Project-owned subset of upstream env.example.
# Example provider/model choices are NOT a team decision or quality claim.
POCS_LIGHTRAG_PORT=9621
# Relative to compose.yaml; instance B can use .env.b here and --env-file.
POCS_LIGHTRAG_SERVER_ENV_FILE=.env
WORKSPACE=pocs_comparison_a
LIGHTRAG_API_KEY=replace-with-local-server-key
LLM_BINDING=openai
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_MODEL=replace-with-approved-chat-model
LLM_BINDING_API_KEY=replace-with-provider-key
EMBEDDING_BINDING=openai
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_MODEL=replace-with-approved-embedding-model
EMBEDDING_DIM=1536
EMBEDDING_BINDING_API_KEY=replace-with-provider-key
SUMMARY_LANGUAGE=Vietnamese
LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
